---
// Full-bleed hero motion: colored threads swirl as a tangle, then settle into calm parallel streams.
// Drawn on a canvas so it stays light (no video download). Respects prefers-reduced-motion with a still frame.
interface Props {
  /** Number of threads. Fewer on small screens automatically. */
  threads?: number;
}
const { threads = 1400 } = Astro.props;
---

<canvas
  class="balance-flow"
  data-balance-flow
  data-threads={threads}
  role="img"
  aria-label="Colored threads swirl in a tangle, then straighten into calm, parallel flowing streams"></canvas>

<script>
  const COLORS = ['#00C2D1', '#14CBD4', '#2EE6D6', '#2FDCA6', '#31D16C', '#007C89', '#00A9B8'];
  const LANES = COLORS.length;
  const BG = '#F7F9FA';

  interface Thread {
    x: number;
    y: number;
    lane: number;
    speed: number;
    jitter: number;
  }

  function ease(t: number) {
    const x = Math.max(0, Math.min(1, t));
    return x * x * (3 - 2 * x);
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const root = canvas.closest<HTMLElement>('[data-balance-root]');
    const caption = root?.querySelector<HTMLElement>('[data-balance-caption]');
    const replay = root?.querySelector<HTMLButtonElement>('[data-balance-replay]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0;
    let H = 0;
    let threads: Thread[] = [];
    let raf = 0;
    let visible = true;
    let startAt = performance.now();
    let settleFrom = startAt;
    let balanced = false;

    function setBalanced(next: boolean) {
      if (next === balanced) return;
      balanced = next;
      if (caption) caption.textContent = next ? 'Balance.' : 'Chaos first.';
    }

    function size() {
      const rect = canvas.parentElement!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = Math.max(1, rect.width);
      H = Math.max(1, rect.height);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.fillStyle = BG;
      ctx!.fillRect(0, 0, W, H);
    }

    function seed() {
      const base = Number(canvas.dataset.threads) || 1400;
      const n = W < 700 ? Math.round(base * 0.5) : base;
      threads = Array.from({ length: n }, (_, i) => ({
        x: Math.random() * W,
        y: Math.random() * H,
        lane: i % LANES,
        speed: 0.6 + Math.random() * 0.9,
        jitter: (Math.random() - 0.5) * 18,
      }));
    }

    const laneY = (lane: number) => H * (0.5 + (lane / (LANES - 1)) * 0.4);

    function step(T: number, order: number) {
      const paths: number[][] = Array.from({ length: LANES }, () => []);
      for (const p of threads) {
        const px = p.x;
        const py = p.y;
        const a =
          (Math.sin(px * 0.0042 + T * 0.35) + Math.cos(py * 0.0058 - T * 0.27) + Math.sin((px + py) * 0.0021 + T * 0.5)) *
          Math.PI;
        const chaosX = Math.cos(a) * 2.4;
        const chaosY = Math.sin(a) * 2.4;
        const targetY = laneY(p.lane) + p.jitter + Math.sin(px * 0.005 + T * 0.6 + p.lane * 0.8) * H * 0.03;
        const calmX = 1.4 * p.speed + 0.5;
        const calmY = (targetY - py) * 0.07;
        p.x += chaosX * (1 - order) + calmX * order;
        p.y += chaosY * (1 - order) + calmY * order;
        let wrapped = false;
        if (p.x > W + 4) (p.x = -4), (wrapped = true);
        else if (p.x < -4) (p.x = W + 4), (wrapped = true);
        if (p.y > H + 4) (p.y = -4), (wrapped = true);
        else if (p.y < -4) (p.y = H + 4), (wrapped = true);
        if (!wrapped) paths[p.lane].push(px, py, p.x, p.y);
      }
      return paths;
    }

    function draw(paths: number[][], fade: number) {
      ctx!.fillStyle = `rgba(247,249,250,${fade})`;
      ctx!.fillRect(0, 0, W, H);
      ctx!.lineWidth = 1.3;
      ctx!.lineCap = 'round';
      ctx!.globalAlpha = 0.6;
      paths.forEach((segs, lane) => {
        if (!segs.length) return;
        ctx!.strokeStyle = COLORS[lane];
        ctx!.beginPath();
        for (let j = 0; j < segs.length; j += 4) {
          ctx!.moveTo(segs[j], segs[j + 1]);
          ctx!.lineTo(segs[j + 2], segs[j + 3]);
        }
        ctx!.stroke();
      });
      ctx!.globalAlpha = 1;
    }

    function stillFrame() {
      let T = 0;
      for (let f = 0; f < 260; f++) {
        T += 1 / 60;
        draw(step(T, 1), 0.06);
      }
      setBalanced(true);
    }

    function loop(now: number) {
      raf = 0;
      if (!visible) return;
      const T = (now - startAt) / 1000;
      const order = ease(((now - settleFrom) / 1000 - 1.6) / 5.5);
      draw(step(T, order), 0.09);
      setBalanced(order > 0.92);
      raf = requestAnimationFrame(loop);
    }

    function run() {
      if (!raf) raf = requestAnimationFrame(loop);
    }

    size();
    seed();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        size();
        seed();
        if (reduce) stillFrame();
      }, 150);
    });

    replay?.addEventListener('click', () => {
      ctx.fillStyle = BG;
      ctx.fillRect(0, 0, W, H);
      seed();
      settleFrom = performance.now();
      setBalanced(false);
      if (reduce) stillFrame();
      else run();
    });

    if (reduce) {
      stillFrame();
      return;
    }

    // Pause when the hero is off screen to save battery.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) run();
    }).observe(canvas);

    run();
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-balance-flow]').forEach(start);
</script>
