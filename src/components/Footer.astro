---
import Logo from './Logo.astro';
import SubscribeForm from './SubscribeForm.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/sanity';
const year = new Date().getFullYear();
// On the homepage the footer is the last panel of the sideways row, so its links jump along the row.
const onHome = ['/', '/index', '/index.html'].includes(Astro.url.pathname);
const hasPosts = (await getPosts()).length > 0;
---

<footer class="site-footer" role="contentinfo">
  <div class="wrap">
    <SubscribeForm />
  </div>
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="EQLBRM, home">
        <Logo kind="lockup" tone="gradient" uid="footer" class="site-footer__lockup" />
      </a>
      <p>Grow with balance.</p>
    </div>
    <ul class="site-footer__links">
      <li><a href={onHome ? '/#services' : '/services'}>Services</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href={onHome && hasPosts ? '/#insights' : '/blog'}>Blog</a></li>
      <li><a href="/#contact">Contact</a></li>
      <li><a href={SITE.social.linkedinCompany} rel="noopener">LinkedIn</a></li>
      <li><a href={SITE.social.instagramCompany} rel="noopener">Instagram</a></li>
      <li><a href="/privacy">Privacy</a></li>
    </ul>
  </div>
  <div class="wrap site-footer__legal">
    <p>&copy; {SITE.legalName} {year}. All rights reserved.</p>
  </div>
</footer>
