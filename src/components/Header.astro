---
import Logo from './Logo.astro';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;

const nav = [
  { href: '/#services', label: 'Services' },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/#clients', label: 'Clients' },
  { href: '/#about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];
const onBlog = Astro.url.pathname.startsWith('/blog');
---

<header class:list={['site-header', `site-header--${theme}`]} data-header data-open="false">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="EQLBRM, home">
      <Logo kind="wordmark" tone={theme === 'dark' ? 'white' : 'gradient'} uid="header" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === '/blog' && onBlog ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--nav" href="/#contact">Get in touch</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  function setOpen(open: boolean) {
    header?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
  }

  toggle?.addEventListener('click', () => setOpen(header?.getAttribute('data-open') !== 'true'));
  header?.querySelectorAll('.site-nav a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
