---
import Logo from './Logo.astro';
import { services } from '../data';
import { getPosts } from '../lib/sanity';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;

// On the homepage every link stays inside the sideways row: Services and Blog jump to their panels
// (Blog only when there are posts to show). Other pages link to the full Services and Blog pages.
const onHome = ['/', '/index', '/index.html'].includes(Astro.url.pathname);
const hasPosts = (await getPosts()).length > 0;
const servicesHref = onHome ? '/#services' : '/services';
const blogHref = onHome && hasPosts ? '/#insights' : '/blog';

const nav = [
  {
    href: servicesHref,
    label: 'Services',
    children: services.map((s) => ({ href: `/services#${s.id}`, label: s.title })),
  },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/#clients', label: 'Clients' },
  { href: '/#about', label: 'About' },
  { href: blogHref, label: 'Blog' },
];
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isCurrent = (href: string) => (href === '/blog' ? path.startsWith('/blog') : href === '/services' ? path === '/services' : false);
---

<header class:list={['site-header', `site-header--${theme}`]} data-header data-open="false">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="EQLBRM, home">
      <Logo kind="lockup" tone={theme === 'dark' ? 'white' : 'gradient'} uid="header" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li class:list={[item.children && 'has-sub']}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <ul class="subnav" aria-label={`${item.label} submenu`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--nav" href="/#contact">Get in touch</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  function setOpen(open: boolean) {
    header?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
  }

  toggle?.addEventListener('click', () => setOpen(header?.getAttribute('data-open') !== 'true'));
  header?.querySelectorAll('.site-nav a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
