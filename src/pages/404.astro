---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | EQLBRM LLC" description="That page could not be found." noindex>
  <div class="wrap">
    <div class="page-head">
      <h1>Page not found.</h1>
      <p class="lead">The link may be old, or the address may have a typo.</p>
    </div>
    <div class="page-body">
      <p><a class="btn" href="/">Go to the home page</a> &nbsp; <a class="btn btn--ghost" href="/blog">Read the blog</a></p>
    </div>
  </div>
</Base>
