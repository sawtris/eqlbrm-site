---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import BalanceFlow from '../components/BalanceFlow.astro';
import VideoPanel from '../components/VideoPanel.astro';
import { SITE } from '../config';
import { stats, testimonials, clients } from '../data';
import { firstExisting } from '../lib/assets';
import { getPosts } from '../lib/sanity';
import { formatDate } from '../lib/format';
import { focalOf, imageUrl } from '../lib/sanityImage';
import '../styles/home.css';

const photo = firstExisting(['images/tristan.jpg', 'images/tristan.jpeg', 'images/tristan.png', 'images/tristan.webp']);
const quotes = testimonials.map((t) => ({
  ...t,
  logoSrc: firstExisting([`logos/${t.logo}.svg`, `logos/${t.logo}.png`, `logos/${t.logo}.webp`]),
}));
const logos = clients.map((client) => ({
  ...client,
  logo: firstExisting([`logos/${client.slug}.svg`, `logos/${client.slug}.png`, `logos/${client.slug}.webp`]),
}));
const latestPosts = (await getPosts()).slice(0, 3);


const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/brand/symbol-gradient.svg`,
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.linkedinCompany, SITE.social.instagramCompany],
  knowsAbout: ['Management consulting', 'Fractional CFO services', 'Health and wellness industry', 'Digital strategy'],
};
---

<Base jsonLd={organization} headerTheme="light" hideFooter>
  <!-- On wide screens the whole page travels sideways as you scroll (see the script below); phones scroll down as normal. -->
  <div class="hscroll" data-hscroll>
  <div class="hscroll__sticky">
  <div class="hscroll__track" data-hscroll-track>
  <!-- Hero: full-bleed motion, chaos settling into balance -->
  <section class="hpanel home-hero" data-balance-root>
    <BalanceFlow />
    <div class="wrap home-hero__inner">
      <div class="home-hero__panel">
        <p class="eyebrow">Wellness consulting</p>
        <h1>Find your <span class="text-gradient">balance.</span></h1>
        <p class="home-hero__lede">
          EQLBRM is a boutique consulting firm specializing in wellness.
          <span>We turn chaos into calm.</span>
        </p>
        <div class="home-hero__actions">
          <a class="btn" href="/#contact">Let's untangle it</a>
          <a class="btn btn--outline" href="/services">What we do</a>
        </div>
        <p class="home-hero__hint" aria-hidden="true">Scroll to explore <span>&rarr;</span></p>
      </div>
    </div>
  </section>

  <!-- Operator credibility -->
  <section class="hpanel section home-intro">
    <div class="wrap">
      <h2 class="home-intro__title">We've run the clubs, the studios and the spas. Now we help the people who run them.</h2>
      <ul class="home-creds">
        <li>
          <p class="eyebrow">Spa and recovery</p>
          <p>Led spa and regeneration globally at Equinox.</p>
        </li>
        <li>
          <p class="eyebrow">Boutique studios</p>
          <p>Ran Fhitting Room through to its acquisition.</p>
        </li>
        <li>
          <p class="eyebrow">Big-box clubs</p>
          <p>Owned strategy and systems at New York Sports Clubs.</p>
        </li>
      </ul>
      <ul class="home-stats">
        {
          stats.map((stat) => (
            <li>
              <span class="home-stats__n">{stat.n}</span>
              <span class="home-stats__l">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What balance looks like: one full-screen panel per video. Files go in public/media/ (see VideoPanel.astro). -->
  <VideoPanel
    name="studio"
    index={1}
    total={3}
    tone="teal"
    eyebrow="The studio"
    title="Classes people plan their week around."
    body="A full class starts long before the doors open. We help studios get the formats, the timetable and the price right, so every class earns its spot."
    points={['Class formats and timetable', 'Pricing, packs and memberships', 'Launch plans for new concepts']}
    link={{ href: '/services#business-strategy', label: 'How we help studios' }}
    alt="An empty, sunlit boutique studio set up for class"
  />
  <VideoPanel
    name="recovery"
    index={2}
    total={3}
    tone="green"
    eyebrow="Recovery"
    title="Recovery people do together."
    body="Sauna, cold plunge, breathwork and bodywork are now a reason to join, not an add-on. We help you design the offer, price it and run it at a profit."
    points={['Recovery concept and service menu', 'Space, staffing and booking flow', 'Pricing and P&L']}
    link={{ href: '/services#financial-operational-services', label: 'How we help with recovery' }}
    alt="A calm recovery space with a sauna, cold plunge and treatment room"
  />
  <VideoPanel
    name="service"
    index={3}
    total={3}
    tone="stone"
    eyebrow="The front desk"
    title="People who know why they stay."
    body="Members decide whether to stay at the front desk and in every moment after it. We map the member journey, fix the systems behind it and give your team the playbook."
    points={['Member journey and service standards', 'CRM, app and booking systems', 'Retention reporting']}
    link={{ href: '/services#digital-strategy', label: 'How we help with service' }}
    alt="A calm, mid-century style front desk with warm wood and no screens"
  />


  <section class="hpanel section" id="testimonials">
    <div class="wrap">
      <h2 class="testimonials__title">What clients say</h2>
      <div class="testimonials">
        {
          quotes.map((t, i) => (
            <figure class="testimonial">
              <Logo kind="symbol" tone="gradient" uid={`quote-${i}`} class="testimonial__mark" />
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption>
                <span class="testimonial__who">
                  <strong>{t.name}</strong>, {t.role}
                </span>
                {t.logoSrc && (
                  <img
                    class="testimonial__logo"
                    src={t.logoSrc}
                    alt={t.company}
                    loading="lazy"
                    style={`--logo-h:${t.logoHeight}px`}
                  />
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="hpanel section section--white" id="clients">
    <div class="wrap">
      <h2>Past clients and experience</h2>
      <ul class="clients__list">
        {
          logos.map((client) => (
            <li>
              {client.logo ? <img src={client.logo} alt={client.name} loading="lazy" style={`--logo-h:${client.height}px`} /> : client.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="hpanel section" id="insights" aria-labelledby="insights-title">
        <div class="wrap">
          <div class="home-blog__head">
            <h2 id="insights-title">From the blog</h2>
            <a href="/blog">All posts</a>
          </div>
          <ul class="home-blog">
            {latestPosts.map((post) => {
              const ref = post.coverImage?.asset?._ref;
              const focal = focalOf(post.coverImage);
              return (
                <li class="home-blog__item">
                  <a href={`/blog/${post.slug}`}>
                    <div class="home-blog__thumb">
                      {ref ? (
                        <img
                          src={imageUrl(ref, { w: 640, h: 480, focal })}
                          srcset={`${imageUrl(ref, { w: 640, h: 480, focal })} 640w, ${imageUrl(ref, { w: 1280, h: 960, focal })} 1280w`}
                          sizes="(min-width: 900px) 360px, 100vw"
                          width="640"
                          height="480"
                          alt={post.coverImage?.alt ?? ''}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <Logo kind="symbol" tone="gradient" uid={`post-${post._id}`} class="home-blog__mark" />
                      )}
                    </div>
                    <p class="home-blog__date">
                      <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                    </p>
                    <h3>{post.title}</h3>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="hpanel section section--navy" id="about">
    <div class:list={['wrap', 'about', photo && 'about--photo']}>
      <div class="about__text">
        <h2>About the founder</h2>
        <p class="about__hello">G'day my name is Tristan.</p>
        <p class="about__roles">Trusted Advisor. Digital Enthusiast. Lifeaholic.</p>
        <p>
          A dynamic and innovative leader with deep global experience driving established and emerging businesses.
        </p>
        <p>Subject Matter Expert in the Health &amp; Wellness industry, with a core specialization in Recovery.</p>
        <p>
          Passionate about building high-performance teams, owning full end-to-end P&amp;L, executing compelling growth
          strategies, and delivering digital business transformation.
        </p>
        <p>Proud husband, father, son, brother, Asian, and Aussie.</p>
        <div class="link-row">
          <a href={SITE.social.linkedinFounder} rel="noopener">LinkedIn</a>
          <a href={SITE.social.instagramFounder} rel="noopener">Instagram</a>
        </div>
      </div>
      {
        photo && (
          <div class="about__photo">
            <img src={photo} alt="Tristan, founder of EQLBRM" loading="lazy" />
          </div>
        )
      }
    </div>
  </section>

  <section class="hpanel section" id="contact">
    <div class="wrap contact">
      <div class="contact__intro">
        <h2>What's out of balance?</h2>
        <p class="lead">A short call is the easiest place to start. No deck, no pitch.</p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        {SITE.bookingUrl && <p><a class="btn btn--outline" href={SITE.bookingUrl}>Book a call</a></p>}
      </div>
      <ContactForm />
    </div>
  </section>
  <div class="hpanel hpanel--footer">
    <Footer />
  </div>
  </div>
  </div>
  </div>
</Base>

<script>
  // Video panel text rises in the first time each panel comes into view.
  const revealIo = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          revealIo.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    el.classList.add('will-reveal');
    revealIo.observe(el);
  });

  // Looping videos play only while on screen, and never for people who prefer reduced motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-loop-video]');
  if (!reduceMotion && videos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.preload = 'auto';
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    videos.forEach((video) => io.observe(video));
  }
</script>

<script>
  // Sideways homepage. On wide screens the panels sit in one long row, the row stays pinned under the header,
  // and scrolling down (wheel, trackpad, keys, scrollbar) moves it left to right. Phones and short windows scroll
  // down as normal. Native scrolling stays in charge, so back/forward, find-in-page and keyboard paging still work.
  const html = document.documentElement;
  const wrap = document.querySelector<HTMLElement>('[data-hscroll]');
  const sticky = wrap?.querySelector<HTMLElement>('.hscroll__sticky');
  const track = document.querySelector<HTMLElement>('[data-hscroll-track]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const wide = window.matchMedia('(min-width: 900px) and (min-height: 560px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (wrap && sticky && track) {
    let on = false;
    let max = 0;
    let start = 0;
    let headerH = 0;
    let ticking = false;
    const parallax = [...track.querySelectorAll<HTMLElement>('[data-parallax]')];

    const isHome = (path: string) => path === '/' || path === '/index' || path === '/index.html';

    function position() {
      ticking = false;
      if (!on) return;
      const x = Math.min(max, Math.max(0, window.scrollY - start));
      track!.style.transform = `translate3d(${-x}px, 0, 0)`;
      html.style.setProperty('--hscroll-progress', max ? String(x / max) : '0');
      // Video panels drift a little slower than the row, so the footage feels deeper than the page.
      if (!reduce.matches) {
        for (const media of parallax) {
          const panel = media.parentElement!;
          const offset = (panel.offsetLeft - x) / window.innerWidth;
          if (offset > -1.2 && offset < 1.2) media.style.transform = `translate3d(${(-offset * 18).toFixed(2)}%, 0, 0)`;
        }
      }
    }

    function measure() {
      headerH = header?.offsetHeight ?? 0;
      html.style.setProperty('--hdr', `${headerH}px`);
      const shouldBeOn = wide.matches;
      if (shouldBeOn !== on) {
        on = shouldBeOn;
        html.classList.toggle('is-horizontal', on);
        if (!on) {
          wrap!.style.height = '';
          track!.style.transform = '';
          parallax.forEach((media) => (media.style.transform = ''));
          return;
        }
      }
      if (!on) return;
      max = Math.max(0, track!.scrollWidth - window.innerWidth);
      wrap!.style.height = `${max + window.innerHeight - headerH}px`;
      start = wrap!.getBoundingClientRect().top + window.scrollY - headerH;
      position();
    }

    function goTo(panel: HTMLElement, smooth = true) {
      const x = Math.min(max, panel.offsetLeft);
      window.scrollTo({ top: start + x, behavior: smooth && !reduce.matches ? 'smooth' : 'auto' });
    }

    window.addEventListener(
      'scroll',
      () => {
        if (on && !ticking) {
          ticking = true;
          requestAnimationFrame(position);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', measure);
    new ResizeObserver(measure).observe(track);
    wide.addEventListener('change', measure);
    measure();

    // In-page links (header nav, hero buttons) jump to the right panel instead of scrolling the hidden row.
    document.addEventListener('click', (event) => {
      if (!on || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!link) return;
      const url = new URL(link.href, location.href);
      if (url.origin !== location.origin || !isHome(url.pathname) || !isHome(location.pathname) || !url.hash) return;
      const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      const panel = target?.closest<HTMLElement>('.hpanel');
      if (!panel || !track.contains(panel)) return;
      event.preventDefault();
      history.pushState(null, '', url.hash);
      goTo(panel);
    });

    // Opening the page at /#contact (or arriving from another page's nav link) lands on that panel.
    // The browser's own jump-to-#section would scroll down instead, so we take over once the page has settled.
    const panelForHash = () =>
      location.hash
        ? document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest<HTMLElement>('.hpanel') ?? null
        : null;
    if (location.hash && 'scrollRestoration' in history) history.scrollRestoration = 'manual';
    const landOnHash = () => {
      sticky.scrollLeft = 0;
      const panel = panelForHash();
      if (panel && on) {
        measure();
        goTo(panel, false);
      }
    };
    if (location.hash) {
      requestAnimationFrame(landOnHash);
      window.addEventListener('load', () => setTimeout(landOnHash, 50), { once: true });
    }
    window.addEventListener('hashchange', landOnHash);
    sticky.addEventListener('scroll', () => {
      sticky.scrollLeft = 0;
    });

    // Keyboard focus moving into an off-screen panel brings that panel into view.
    document.addEventListener('focusin', (event) => {
      if (!on) return;
      sticky.scrollLeft = 0;
      const panel = (event.target as Element).closest<HTMLElement>('.hpanel');
      if (!panel || !track.contains(panel)) return;
      const x = Math.min(max, Math.max(0, window.scrollY - start));
      const left = panel.offsetLeft;
      if (left + panel.offsetWidth <= x || left >= x + window.innerWidth) goTo(panel, false);
    });

    // Left and right arrow keys move along the row too.
    document.addEventListener('keydown', (event) => {
      if (!on || event.altKey || event.metaKey || event.ctrlKey) return;
      const el = event.target as HTMLElement;
      if (el.closest('input, textarea, select, [contenteditable="true"]')) return;
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        const step = window.innerWidth * 0.8 * (event.key === 'ArrowRight' ? 1 : -1);
        window.scrollBy({ top: step, behavior: reduce.matches ? 'auto' : 'smooth' });
      }
    });
  }
</script>
