{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eqlbrm-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker. Everything else is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO_EMAIL": "tristan@eqlbrm.io",
    "CONTACT_FROM_EMAIL": "EQLBRM Website <onboarding@resend.dev>"
  },
  "observability": { "enabled": true }
}
